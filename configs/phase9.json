{
  "schema": 1,
  "train_seeds": [3101, 3203],
  "evaluation_seeds": [4101, 4201, 4301, 4409, 4507],
  "training_scenarios": ["clean", "moderate", "severe", "sustained"],
  "evaluation_scenarios": ["clean", "moderate", "severe", "structured", "sustained", "outage_2", "outage_8", "outage_20", "camera_independent", "camera_ball"],
  "seed_formula": "base + 100000*match_index + 1000*half; development match_index=100",
  "training_stride": 25,
  "validity_error_metres": 2.0,
  "false_tracks_per_minute": 6,
  "false_track_seconds": [2, 8],
  "false_offset_metres": [10, 30],
  "outages_per_minute": 3,
  "camera_blocks_seconds": 8,
  "camera_half_width_metres": 25,
  "camera_duplicate_slots_per_team": 2,
  "calibration": "last training match only; remaining training matches fit HGB; sigmoid logit calibration C=1",
  "classifier": {"max_iter": 80, "max_leaf_nodes": 7, "min_samples_leaf": 80, "l2_regularization": 1, "early_stopping": false, "random_state": 2026},
  "fusion": "q_new=min(q_original, calibrated_validity); otherwise frozen v1",
  "gates": {"mean_gain": 0.01, "winning_matches": 3, "max_match_loss": 0.01, "max_condition_loss": 0.01, "max_long_recall_loss": 0.01, "sustained_gain_strictly_positive": true, "independent_camera_gain_strictly_positive": true},
  "development_rule": "one fixed comparison only if CV gates pass; same gain and regression guards except fold-win count",
  "retune_after_results": false,
  "allow_target_or_final_holdouts": false
}
